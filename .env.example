# URL du projet Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publishable (sb_publishable_...). Publique par conception : la RLS protège les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL publique de l'app, utilisée dans les liens des e-mails. Inutile sur Vercel (adresse de production détectée).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uniquement pour les tests RLS en local ou en CI : un Postgres jetable, jamais la vraie base.
# DATABASE_URL_TEST=postgres://postgres@localhost:54329/postgres

# Interface IA (désactivée en v1). Ne pas activer sans en parler.
FEATURE_AI=false
